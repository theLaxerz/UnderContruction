{
  "manifest_version": 3,
  "name": "DOM Control API Extension",
  "version": "1.0.0",
  "description": "A browser extension that connects to an API for full DOM control and manipulation",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/dom-controller.js", "scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DOM Control API"
  },

  "options_page": "pages/options.html",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["styles/*", "scripts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
